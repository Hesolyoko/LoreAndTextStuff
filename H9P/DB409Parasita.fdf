ta/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:10.0pt;text-align:left;color:#000000;font-weight:normal;font-style:norma\l;font-family:Helvetica,sans-serif;font-stretch:normal"><p dir="ltr"><span style="font-family:Helvetica">Golpes com Plantas - Utiliza vinhas e plantas para golpear os inimigos normalmente, variando desde golpes diretos, rasteiras, perfura&#231;&#227;o dos\ alvos ou at&#233; envolver um objeto para bater ou arremess&#225;-lo.</span></p></body>)/Rect[180.873 653.802 516.439 711.812]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj101 0 obj<</BS<</W 0>>/CA 1/Contents(Restringir - Caso a estratégia mude para imobilizar o alvo, pode usar as plantas para capturar algumas partes de seu corpo, ou envolvê-lo completamente em um casulo de plantas, ou, em raras ocasiões, pode mover os "cômodos" para confundir ou separá-los.)/DA(0 0 0 RG 0 0 0 rg /Helv 10 Tf)/DS(font: Helvetica,sans-serif 10.0pt; text-align:left; color:#000000 )/F 4/M(D:20240915090804-03'00')/NM(c91dd0727aea4492802a48e2eeb56f21)/Page 2/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:10.0pt;text-align:left;color:#000000;font-weight:normal;font-style:norma\l;font-family:Helvetica,sans-serif;font-stretch:normal"><p dir="ltr"><span style="font-family:Helvetica">Restringir - Caso a estrat&#233;gia mude para imobilizar o alvo, pode usar as plantas para capturar algumas partes de seu corpo, ou envolv&#234;-lo co\mpletamente em um casulo de plantas, ou, em raras ocasi&#245;es, pode mover os &quot;c&#244;modos&quot; para confundir ou separ&#225;-los.</span></p></body>)/Rect[181.528 553.844 517.093 623.854]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj102 0 obj<</BS<</W 0>>/CA 1/Contents(Esporos Parasitas \(Ø\) - Usa algumas plantas para soltar uma nuvem de esporos as quais podem causar os mais diversos efeitos nos alvos, podendo envenená-los a 1% do Dif de SC por turno, causar alucinações, reduzindo o valor das Propriedades do Alvo em 1/\3 se orgânico e compatível, e sendo também uma maneira comum de reprodução. Nesta Ficha, o Apresto se encontra bloqueado enquanto os alvos estiverem na área do parasita equivalente ao hotel.)/DA(0 0 0 RG 0 0 0 rg /Helv 8 Tf)/DS(font: Helvetica,sans-serif 8.0pt; text-align:left; color:#000000 )/F 4/M(D:20240915091404-03'00')/NM(0b13cda8c8ee498badf7f34d2c2a2f89)/Page 2/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:8.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal\;font-family:Helvetica;font-stretch:normal"><p dir="ltr">Esporos Parasitas \(<span style="font-weight:bold;font-family:Arial">&#216;</span>\) - Usa algumas plantas para soltar uma nuvem de esporos as quais podem causar os mais diversos efeitos nos alvos, \podendo envenen&#225;-los a 1% do Dif de SC por turno, causar alucina&#231;&#245;es, reduzindo o valor das Propriedades do Alvo em 1/3 se org&#226;nico e compat&#237;vel, e sendo tamb&#233;m uma maneira comum de reprodu&#231;&#227;o. Nesta Ficha, o Aprest\o se encontra bloqueado enquanto os alvos estiverem na &#225;rea do parasita equivalente ao hotel.</p></body>)/Rect[181.528 475.919 518.402 531.582]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj103 0 obj<</BS<</W 0>>/CA 1/Contents(Espreita - Por ser parte de praticamente todo o ambiente de batalha, pode se aproveitar disso entrando em modo de espreita ao usar esse Apresto, dando uma abertura para camuflar-se, retrair-se do cômodo, confundir o oponente através de objetos no cômodo, \ou até marcá-los com um sinalizador irritante.)/DA(0 0 0 RG 0 0 0 rg /Helv 9 Tf)/DS(font: Helvetica,sans-serif 9.0pt; text-align:left; color:#000000 )/F 4/M(D:20240915093138-03'00')/NM(4ad9b17ed327424288eb2d55c9c580e4)/Page 2/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:9.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal\;font-family:Helvetica;font-stretch:normal"><p dir="ltr">Espreita - Por ser parte de praticamente todo o ambiente de batalha, pode se aproveitar disso entrando em modo de espreita ao usar esse Apresto, dando uma abertura para camuflar-se, retrair-se do c&\#244;modo, confundir o oponente atrav&#233;s de objetos no c&#244;modo, ou at&#233; marc&#225;-los com um sinalizador irritante.</p></body>)/Rect[182.183 284.737 515.13 354.747]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj104 0 obj<</BS<</W 0>>/CA 1/Contents(Absorção - Ao deixar um alvo vulnerável \(Destruir todos os seus Aprestos, Romper a Ligação Propriedade/Essência...\) pode utilizar esse Apresto para devorá-lo e terminar a luta.)/DA(0 0 0 RG 0 0 0 rg /Helv 10 Tf)/DS(font: Helvetica,sans-serif 10.0pt; text-align:left; color:#000000 )/F 4/M(D:20240915092531-03'00')/NM(e5d6d6beb785412c93a0ea2c110921d7)/Page 2/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:10.0pt;text-align:left;color:#000000;font-weight:normal;font-style:norma\l;font-family:Helvetica,sans-serif;font-stretch:normal"><p dir="ltr"><span style="font-family:Helvetica">Absor&#231;&#227;o - Ao deixar um alvo vulner&#225;vel \(Destruir todos os seus Aprestos, Romper a Liga&#231;&#227;o Propriedade/Ess&#234;ncia...\) po\de utilizar esse Apresto para devor&#225;-lo e terminar a luta.</span></p></body>)/Rect[182.183 386.612 494.184 444.622]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj105 0 obj<</BS<</W 0>>/CA 1/Contents(                                                                                                         Anotações\r