al,sans-serif 8.0pt; text-align:left; color:#000000 )/F 4/M(D:20240913185634-03'00')/NM(307836cabaec465cb2dae4cf3ecee1a4)/Page 1/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:8.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal\;font-family:Arial,sans-serif;font-stretch:normal"><p dir="ltr"><span style="text-align:justify;font-family:Arial">Um olho de apar&#234;ncia drac&#244;nica, especulado por testemunhas como originado de uma criatura como um basilisco, e cor avermelhada com\ esclera preta e veias capilares amarelas. </span><span style="text-align:justify;font-family:Arial">Uma aura amea&#231;adora constantemente paira pelo objeto.</span></p></body>)/Rect[432.253 225.905 573.404 339.515]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj33 0 obj<</BS<</W 0>>/CA 1/Contents(Desconhecida, presumivelmente não amigável.)/DA(0 0 0 RG 0 0 0 rg /Helv 10 Tf)/DS(font: Helvetica,sans-serif 10.0pt; text-align:left; color:#000000 )/F 4/M(D:20240913185704-03'00')/NM(bb138ce29a0f43518600d4a0c15c9228)/Page 1/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:10.0pt;text-align:left;color:#000000;font-weight:normal;font-style:norma\l;font-family:Helvetica,sans-serif;font-stretch:normal"><p dir="ltr"><span style="font-family:Helvetica">Desconhecida, presumivelmente n&#227;o amig&#225;vel.</span></p></body>)/Rect[216.001 241.602 398.62 287.612]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj34 0 obj<</BS<</W 0>>/CA 1/Contents(Caso um indivíduo pegue o objeto, um sentimento constante de alerta é sentido por ele e uma condição é imposta a ele sem sua percepção ou consentimento. Se o indivíduo desfazer o contato com o objeto, ele é instantaneamente morto e desintegrado, de maneir\a dolorosa, mas sem deixar rastros. É desconhecido se é possível destruir o objeto, e muitos tentaram, mas muito poucos podem relatar a sua existência nos fóruns.)/DA(0 0 0 RG 0 0 0 rg 0 Tc 0 Tw 100 Tz 0 TL 0 Ts 0 Tr /Arial 10 Tf)/DS(font: Arial,sans-serif 10.0pt; text-align:left; color:#000000 )/F 4/M(D:20240913185802-03'00')/NM(d7acb930cdb148c288da8a71ac95f1c3)/Page 1/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:10.0pt;text-align:left;color:#000000;font-weight:normal;font-style:norma\l;font-family:Helvetica,sans-serif;font-stretch:normal"><p dir="ltr"><span style="text-align:justify;font-family:Arial">Caso um indiv&#237;duo pegue o objeto, um sentimento constante de alerta &#233; sentido por ele e uma condi&#231;&#227;o &#233; imposta\ a ele sem sua percep&#231;&#227;o ou consentimento. Se o indiv&#237;duo desfazer o contato com o objeto, ele &#233; instantaneamente morto e desintegrado, de maneira dolorosa, mas sem deixar rastros. &#201; desconhecido se &#233; poss&#237;vel destruir o\ objeto, e muitos tentaram, mas muito poucos podem relatar a sua exist&#234;ncia nos f&#243;runs.</span></p></body>)/Rect[45.3301 160.864 571.292 206.874]/Subj(Text Box)/Subtype/FreeText/T( )/Type/Annot>>endobj35 0 obj<</BS<</W 0>>/CA 1/Contents(                                                                                                         Anotações\r)/DA(0 0 0 RG 0 0 0 rg 0 Tc 0 Tw 100 Tz 0 TL 0 Ts 0 Tr /Helv 17.1 Tf)/DS(font: Helvetica,sans-serif 17.1pt; text-align:left; color:#000000 )/F 4/M(D:20240907221411-03'00')/NM(5f15e8eb9fc54a00959a0547e7205bd6)/Page 3/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.3.0" xfa:spec="2.0.2"  style="font-size:17.1pt;text-align:left;color:#000000;font-weight:normal;font-style:norma\l;fo